{
  "name": "obsidian-latest-mathjax",
  "version": "0.1.1",
  "description": "Use the latest MathJax engine for mathematical rendering in Obsidian.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build && npm run release:check",
    "release:check": "node scripts/validate-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mathjax",
    "latex",
    "math"
  ],
  "author": "HuaJiaHao",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.3.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3"
  }
}
