{
  "name": "obsidian-latest-mathjax",
  "version": "1.2.0",
  "description": "Use the latest MathJax engine for mathematical rendering in Obsidian.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "npm run font-packs:generate && vitest run",
    "test:watch": "vitest",
    "bench:generate": "node scripts/generate-benchmarks.mjs",
    "font-packs:generate": "node scripts/generate-font-packs.mjs",
    "check": "npm run lint:api && npm test && npm run build && npm run release:check",
    "lint:api": "eslint \"src/**/*.ts\" --max-warnings 0",
    "release:check": "node scripts/validate-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mathjax",
    "latex",
    "math"
  ],
  "author": "HuaJiaHao",
  "license": "MIT",
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@mathjax/mathjax-asana-font": "^4.1.3",
    "@mathjax/mathjax-bonum-font": "^4.1.3",
    "@mathjax/mathjax-dejavu-font": "^4.1.3",
    "@mathjax/mathjax-fira-font": "^4.1.3",
    "@mathjax/mathjax-modern-font": "^4.1.3",
    "@mathjax/mathjax-pagella-font": "^4.1.3",
    "@mathjax/mathjax-schola-font": "^4.1.3",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@mathjax/mathjax-termes-font": "^4.1.3",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^30.0.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3"
  }
}
